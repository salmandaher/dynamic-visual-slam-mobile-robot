<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>new_arm_moveit_config</name>
  <version>0.1.0</version>
  <description>MoveIt 2 motion-planning configuration for the new_arm robotic arm.</description>

  <maintainer email="nsnn1324@gmail.com">salman</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The robot geometry this config wraps. -->
  <exec_depend>new_arm_description</exec_depend>

  <!-- MoveIt core + launch utilities. -->
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>

  <!-- ros2_control stack for (mock) trajectory execution (demo.launch.py). -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>

  <!-- Real-arm bring-up (arm_bringup.launch.py): host driver that owns
       /joint_states + the FollowJointTrajectory action server. -->
  <exec_depend>new_arm_driver</exec_depend>

  <!-- Description / visualization helpers. -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
