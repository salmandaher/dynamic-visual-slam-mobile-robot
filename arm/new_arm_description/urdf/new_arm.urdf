<?xml version="1.0"?>
<robot name="new_arm">

  <material name="grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.9 0.5 0.1 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.4 0.9 1.0"/>
  </material>

  <link name="arm_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://new_arm_description/meshes/stl/arm_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://new_arm_description/meshes/stl/arm_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="after_base_full_joint" type="revolute">
    <parent link="arm_base_link"/>
    <child link="after_base_full_link"/>
    <origin xyz="0.00043239 -0.00184063 0.08396122" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="after_base_full_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://new_arm_description/meshes/stl/after_base_full.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://new_arm_description/meshes/stl/after_base_full.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="link1_joint" type="revolute">
    <parent link="after_base_full_link"/>
    <child link="link1_link"/>
    <origin xyz="0.00814224 -0.00043239 0.00161718" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 1.57080"/>
      <geometry>
        <mesh filename="package://new_arm_description/meshes/stl/link1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 1.57080"/>
      <geometry>
        <mesh filename="package://new_arm_description/meshes/stl/link1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.00084107 0.00290 0.06494700" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.000135" ixy="0" ixz="0" iyy="0.000134" iyz="0" izz="0.0000054"/>
    </inertial>
  </link>

  <joint name="link2_joint" type="revolute">
    <parent link="link1_link"/>
    <child link="link2_link"/>
    <origin xyz="0.001 -0.00856 0.12839612" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link2_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://new_arm_description/meshes/stl/link2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://new_arm_description/meshes/stl/link2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.05192619 0.01092440 -0.01511619" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0000466" ixy="0" ixz="0.0000759" iyy="0.00022" iyz="0" izz="0.000188"/>
    </inertial>
  </link>

  <joint name="end_effector_joint" type="revolute">
    <parent link="link2_link"/>
    <child link="end_effector_link"/>
    <origin xyz="0.12531939 0.01099 -0.05778452" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="5.0" velocity="1.0"/>
  </joint>

  <link name="end_effector_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.57080 0"/>
      <geometry>
        <mesh filename="package://new_arm_description/meshes/stl/end_effector.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.57080 0"/>
      <geometry>
        <mesh filename="package://new_arm_description/meshes/stl/end_effector.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

</robot>
